# Copy to .env.local and configure a browser application Key from Tianditu.
# VITE_* values are included in the browser bundle. Set allowed domains in the
# provider console; never use a private server credential here.
VITE_TIANDITU_KEY=

# Public assets: copy this URL for OSS development, or leave empty for public/.
# Production builds use .env.production; shell variables override all .env files.
VITE_ASSET_BASE_URL=https://halfbvg-art-assets.oss-cn-shanghai.aliyuncs.com/where-is-art/
