# Copy to .env.local and configure a browser application Key from Tianditu.
# VITE_* values are included in the browser bundle. Set allowed domains in the
# provider console; never use a private server credential here.
VITE_TIANDITU_KEY=

# Development and production default to OSS via .env.
# After npm run media:restore, leave this empty to use local public/ media.
# Shell variables override all .env files.
VITE_ASSET_BASE_URL=https://halfbvg-art-assets.oss-cn-shanghai.aliyuncs.com/where-is-art/

# Leave empty to preview generated local catalog edits before publishing.
VITE_CONTENT_BASE_URL=https://halfbvg-art-assets.oss-cn-shanghai.aliyuncs.com/where-is-art/content/
