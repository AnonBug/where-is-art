  "curation": {
    "signature": {
      "note": "成名作作为代表作入口，不断言每件是画家首次成名之作。保留原有唐寅与达·芬奇的选择；其余画家各一件。韦罗基奥现仅有与达·芬奇合作的《基督受洗》，不重复占用一人一幅名额。吴道子、王维、阎立本条目沿用原作说明中的传名、临摹与归属限定，不改写为亲笔。"
    },
    "rembrandt-self-portraits": {
      "note": "按目录约略起始年代排列。包括以自己为模特的角色装扮；排除现有目录明确标注作者归属存在限定或不同意见的五条记录。不宣称穷尽全部自画像。",
      "excludedArtworkIds": [
        "rembrandt-rrp-134",
        "rembrandt-rrp-146",
        "rembrandt-rrp-154",
        "rembrandt-rrp-170",
        "rembrandt-rrp-235a"
      ],
      "sources": [
        "https://www.nationalgallery.org.uk/paintings/rembrandt-self-portrait-at-the-age-of-63"
      ]
    },
    "monet-water-lilies": {
      "note": "24件精选，按早期池塘与日本桥、1900年代水面、晚期绘画、橘园组画组织；不是全部睡莲目录。橘园收录现有目录中可浏览的六幅组画，不虚构缺失作品。逐件来源、尺寸与收藏沿用目录。",
      "sources": [
        "https://www.musee-orangerie.fr/en/node/197502",
        "https://www.artic.edu/artworks/16568",
        "https://www.metmuseum.org/art/collection/search/438008"
      ]
    },
    "van-gogh-sunflowers": {
      "note": "收录四件巴黎剪枝静物与六件阿尔勒瓶花版本；不将混合花卉、庭园、房屋或已毁的五朵向日葵影像并作现存系列。未知收藏地点的作品留在列表，不增加地图坐标。",
      "excludedArtworkIds": [
        "van-gogh-q11770758",
        "van-gogh-q19836161",
        "van-gogh-q26220198",
        "van-gogh-q26221241"
      ],
      "sources": [
        "https://www.vangoghmuseum.nl/en/collection/s0031V1962",
        "https://www.nationalgallery.org.uk/paintings/vincent-van-gogh-sunflowers"
      ]
    },
    "danae": {
      "note": "按现有作品ID收录提香五个版本与伦勃朗一件，保留作品本身题名“达娜厄”。阿普斯利邸、普拉多、那不勒斯、维也纳、冬宫版本不合并；不添加尚未入库画家的图像，也不为未关联馆点的作品补造坐标。",
      "sources": [
        "https://www.gardnermuseum.org/danae",
