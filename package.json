{
  "name": "art-atlas",
  "version": "4.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8775 --strictPort",
    "build": "node scripts/build-theme.mjs && tsc --noEmit && vite build && node scripts/check-site-size.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8775 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig.json package.json",
    "predev": "node scripts/build-theme.mjs",
    "content:build": "node scripts/build-catalog.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:foreign": "node scripts/prepare-foreign-media.mjs",
    "media:wu-daozi": "node scripts/prepare-wu-daozi-media.mjs",
    "media:tang-expansion": "node scripts/prepare-tang-expansion-media.mjs",
    "media:check": "node scripts/check-media-index.mjs",
    "media:check:local": "node scripts/check-local-media.mjs && node scripts/check-media.mjs && node scripts/check-foreign-media.mjs && node scripts/check-wu-daozi-media.mjs && node scripts/check-tang-expansion-media.mjs",
    "media:check:remote": "node scripts/check-remote-media.mjs",
    "media:index": "node scripts/build-media-index.mjs",
    "media:restore": "node scripts/restore-media.mjs",
    "media:legacy": "node scripts/prepare-legacy-media.mjs",
    "media:masters": "node scripts/prepare-masters-media.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.16.0",
    "openseadragon": "6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.5",
    "supercluster": "9.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/openseadragon": "5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "sass": "1.107.1",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
